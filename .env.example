# ---- ant-adsb-radar runtime config ----
# Copy to .env (next to docker-compose.yml). The backend container reads it;
# PUBLIC_API_URL and ORIGIN also feed the frontend build.

# Backend -> readsb-protobuf. Either your readsb host's LAN address (readsb
# publishes :8080 there), or http://readsb:8080 if the backend joins readsb's
# docker network.
READSB_URL=http://readsb-host:8080
READSB_POLL_INTERVAL=1.0
NEAREST_COUNT=12

# Enrich contacts with registration/type/operator from readsb's own /db/
# (default on).
# ENRICH=true

# Browser -> backend (API + SSE). Must be reachable from the kiosk display —
# use the docker host's LAN address, not localhost.
PUBLIC_API_URL=http://radar-host:8001

# adapter-node origin for the frontend (CSRF / absolute URLs): how the kiosk
# reaches the frontend.
ORIGIN=http://radar-host:3000

# Host ports to publish. Change them to run a second instance beside another
# (PUBLIC_API_URL and ORIGIN above must use the same ports).
# FRONTEND_PORT=3000
# BACKEND_PORT=8001

# Optional: read-only Postgres URL of a personal flights database, to circle
# the aircraft you've flown on. See backend/app/services/flown.py for the
# tables it expects. Leave unset to disable.
# FLIGHTS_DB_URL=postgresql://user:password@db-host/flights
